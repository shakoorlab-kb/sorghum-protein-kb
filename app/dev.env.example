# Copy to dev.env for local development (dev.env is git-ignored).
export SI_KB_DIR=/path/to/sorghum-protein-kb/kb
export SI_DATA_DIR=/path/to/sorghum-protein-kb/app/.devdata
export NEO4J_URI=bolt://127.0.0.1:47687
export NEO4J_USER=neo4j
export NEO4J_PASSWORD=devpassword123
export SI_ADMIN_PASSWORD=change-me
export SI_SESSION_SECRET=change-me-to-a-long-random-string
export SI_EXTRACT_WORKERS=8
export PYTHONPATH=/path/to/sorghum-protein-kb/app/backend
# export OPENROUTER_API_KEY=...        # chat and automatic extraction
# export KB_CONTACT_EMAIL=you@example.org
